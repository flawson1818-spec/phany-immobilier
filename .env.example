# ---------------------------------------------------------------------------
# PHANY IMMOBILIER — variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# NE JAMAIS committer .env — secrets uniquement ici en placeholder.
# ---------------------------------------------------------------------------

# PostgreSQL (Supabase : Project Settings > Database > Connection string)
# DATABASE_URL  = connexion "pooler" (port 6543, ?pgbouncer=true) pour l'app
# DIRECT_URL    = connexion directe (port 5432) pour les migrations Prisma
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Secret de session JWT — générer avec : openssl rand -base64 48
SESSION_SECRET="change-me-with-a-64-char-random-string"

# URL publique de l'app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase Storage (upload des photos de biens) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="properties"

# --- PHANY AI (optionnel : fallback heuristique si vide) ---
# AI_PROVIDER : "heuristic" (defaut) | "anthropic" | "openai"
AI_PROVIDER="heuristic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Email (optionnel : reset de mot de passe ; sinon lien loggé en console) ---
RESEND_API_KEY=""
EMAIL_FROM="PHANY IMMOBILIER <no-reply@phany.tg>"

# Premier compte admin créé par `npm run db:seed`
SEED_ADMIN_EMAIL="admin@phany.tg"
SEED_ADMIN_PASSWORD="ChangeMoi2026!"
